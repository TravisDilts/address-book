# Ignore Visual Studio temporary files, build results, and
# files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono Auto Generated Files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio Code
.vscode/

# Rider
.idea/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Angular specific
node_modules/
dist/
tmp/
out-tsc/
.angular/
.angular-cache/

# Environment files
*.env
*.env.*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Compiled TypeScript
*.tsbuildinfo

# Package lock files
package-lock.json
yarn.lock

# Coverage directory used by tools like istanbul
coverage/

# Miscellaneous
*.log
*.swp
*.bak
*.tmp
*.temp
*.DS_Store
Thumbs.db